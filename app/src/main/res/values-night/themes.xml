        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>
        <item name="colorSurfaceInverse">@color/md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/md_inverse_primary</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>

        <!-- Component defaults -->
        <item name="bottomNavigationStyle">@style/Widget.CAQMN.BottomNavigationView</item>
        <item name="materialCardViewStyle">@style/Widget.CommunityAirMonitor.Card</item>
        <item name="materialButtonStyle">@style/Widget.CommunityAirMonitor.Button.Primary</item>
        <item name="toolbarStyle">@style/Widget.CommunityAirMonitor.Toolbar</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.CommunityAirMonitor.Dialog</item>

        <!-- Rounded shapes -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.CommunityAirMonitor.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CommunityAirMonitor.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.CommunityAirMonitor.Large</item>
